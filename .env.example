# ==================== 腾讯文档配置 ====================
# 腾讯在线文档ID（从文档URL中获取，参考 docId.png）
TENCENT_DOCS_ID=300000000$AxnretFMZGkj

# 腾讯文档Cookie（从浏览器开发者工具获取，参考 cookie.png）
TENCENT_DOCS_COOKIE='your_cookie_here'

# ==================== 用户信息配置 ====================
# 用户姓名（用于筛选工作记录）
USER_NAME=张三

# 部门名称（用于生成日报/周报邮件主题）
DEPARTMENT=前端开发部

# ==================== 绩效配置 ====================
# 年份（默认：当前年份）
YEAR=2026

# 月份（默认：当前月份，用于生成绩效）
MONTH=1

# 排除成员（绩效校验时忽略的成员，多个用逗号分隔）
EXCLUDE_MEMBER=张三,李四

# ==================== 邮件配置 - 腾讯企业邮箱 ====================
# SMTP服务器地址
EMAIL_HOST=smtp.exmail.qq.com

# SMTP端口
EMAIL_PORT=465

# 发件人邮箱地址
EMAIL_USER=your_email@company.com

# 邮箱授权码（不是登录密码，需在邮箱设置中生成）
EMAIL_PASSWORD=your_auth_code

# 发件人显示名称（格式：姓名<邮箱>）
EMAIL_FROM=张三<your_email@company.com>

# ==================== IMAP配置 - 保存已发送邮件 ====================
# IMAP服务器地址
EMAIL_IMAP_HOST=imap.exmail.qq.com

# IMAP端口
EMAIL_IMAP_PORT=993

# 已发送文件夹名称（腾讯企业邮箱通常是 "Sent Messages"）
EMAIL_SENT_FOLDER=Sent Messages

# 是否保存到已发送文件夹（true/false，默认true）
EMAIL_SAVE_TO_SENT=true

# ==================== 邮件收件人配置 ====================
# 收件人（多个用逗号分隔）
EMAIL_TO=recipient1@company.com,recipient2@company.com

# 抄送（多个用逗号分隔，可选）
EMAIL_CC=cc@company.com

# ==================== 工作日判断配置 ====================
# 是否检查工作日（true/false，默认true）
# 启用后会自动识别节假日和周末，仅在工作日发送邮件
EMAIL_CHECK_WORKDAY=true

# ==================== Server酱通知配置（可选）====================
# Server酱SendKey（用于青龙面板任务执行通知）
# 获取地址：https://sct.ftqq.com/
SERVERCHAN_KEY=your_sendkey_here

# Server酱抄送 openid（多个用英文逗号分隔）
# 仅在所选消息通道支持 openid 抄送时生效
SERVERCHAN_OPENIDS=openid_1,openid_2

# 通知标题前缀（默认青龙任务）；A8 工时填报会自动使用“A8工时填报”，可覆盖
# SERVERCHAN_TITLE_PREFIX=青龙任务

# ==================== A8 工时填报配置（可选）====================
# 默认复用上方 A8 系统配置（A8_BASE_URL / A8_LOGIN_URL / A8_USERNAME / A8_PASSWORD）
# 如需单独配置，可取消注释并修改以下值
A8_WORK_URL=http://120.35.0.67:28101/seeyon/main.do?method=main
A8_WORK_USERNAME=1003854
A8_WORK_PASSWORD=your_password

# 填写方式：template（调用模板）或 copy（复制历史记录）
A8_WORK_FILL_METHOD=copy

# Playwright 浏览器设置
A8_WORK_HEADLESS=true
A8_WORK_SLOWMO=300

# Python 解释器命令：Windows 用 python 或 py，Linux/青龙面板用 python3
# A8_WORK_PYTHON=python3

# 单账号最多尝试次数（含首次），默认 2。A8 服务端延迟波动会使「发送前」阶段
# （登录/导航/复制历史记录）偶发失败，重跑一次通常即成功；一旦已点击「发送」则绝不重试，
# 避免重复提交工时。设为 1 可关闭重试。
# A8_FILL_ATTEMPTS=2

# 青龙面板首次部署时需一次性初始化 Playwright 环境，在青龙容器内执行：
#   cd /ql/data/scripts/performance-tool && npm run setup:a8
# 该脚本会向 A8_WORK_PYTHON 指向的解释器安装 playwright 并下载 Chromium。
# 若青龙已有带 playwright 的专用 Python（如 python3.12），可直接设 A8_WORK_PYTHON 指向它而无需重装。

# pip 源：脚本会依次尝试 A8_PIP_INDEX（若设置）、阿里云、清华、腾讯云、华为云、官方 pypi，
# 取第一个能装到 playwright 的源，并自动清理陈旧缓存。一般无需设置；
# 仅当你需要固定为某个源时再指定：
# A8_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
